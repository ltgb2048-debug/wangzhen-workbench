<Window x:Class="WangzhenWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="王震工作进度台"
        Width="470" Height="820" MinWidth="420" MinHeight="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F5F9FF"/>
            <Setter Property="Background" Value="#253957"/>
            <Setter Property="BorderBrush" Value="#355478"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22" Background="#F0162742" BorderBrush="#36577E" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="王震工作进度台" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="DateText" Foreground="#9FC2E7" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="—" Width="34" Height="28" Style="{StaticResource ActionButton}" Background="#334D6B" Click="Minimize_Click"/>
                    <Button Content="×" Width="34" Height="28" Style="{StaticResource ActionButton}" Background="#6B3340" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,8">
                <StackPanel>
                    <Border Background="#203958" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="今日完成度" Foreground="#D9ECFF" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OverallText" Grid.Column="1" Text="0%" Foreground="White" FontSize="22" FontWeight="Bold"/>
                            </Grid>
                            <ProgressBar x:Name="OverallProgress" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,10,0,0" Foreground="#4EA1FF" Background="#13253C" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="今日任务" Foreground="White" FontSize="18" FontWeight="Bold" Margin="2,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding TodayTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1F3552" CornerRadius="12" Padding="12" Margin="0,0,0,8" BorderBrush="#2E4B6C" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#294C73" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Priority}" Foreground="#BFE1FF" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Grid Margin="0,9,8,0">
                                                <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding Progress}" Foreground="#4EA1FF" Background="#102239" BorderThickness="0"/>
                                            </Grid>
                                            <TextBlock Text="{Binding StatusText}" Foreground="#88AFD4" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DueText}" Foreground="#A8C9E9" HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsManualProgress, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="-10" Tag="{Binding}" Style="{StaticResource ActionButton}" Background="#334D6B" Padding="7,4" Click="DecreaseProgress_Click"/>
                                                <Button Content="+10" Tag="{Binding}" Style="{StaticResource ActionButton}" Padding="7,4" Click="IncreaseProgress_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" Foreground="#DDEEFF" HorizontalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="项目节点" Foreground="White" FontSize="18" FontWeight="Bold" Margin="2,10,0,8"/>
                    <ItemsControl ItemsSource="{Binding Milestones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#182D47" CornerRadius="10" Padding="10" Margin="0,0,0,7" BorderBrush="#294B6D" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#EDF7FF" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DueText}" Foreground="#84ABD0" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#FFCC80" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="快速添加" Foreground="White" FontSize="18" FontWeight="Bold" Margin="2,10,0,8"/>
                    <Border Background="#1A304A" CornerRadius="12" Padding="10">
                        <StackPanel>
                            <TextBox x:Name="NewTaskTitleBox" ToolTip="任务名称"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DueTimeBox" Text="18:00" ToolTip="截止时间，例如 17:30"/>
                                <ComboBox x:Name="PriorityBox" Grid.Column="1" SelectedIndex="1">
                                    <ComboBoxItem Content="S"/>
                                    <ComboBoxItem Content="A"/>
                                    <ComboBoxItem Content="B"/>
                                </ComboBox>
                            </Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,4">
                                <CheckBox x:Name="ManualProgressBox" Foreground="#DCEBFA" Content="手动百分比进度" Margin="0,0,10,0"/>
                                <Button Content="添加今日任务" Style="{StaticResource ActionButton}" Click="AddTask_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="StatusText" Foreground="#8FB4D8" FontSize="11" Margin="4,0,4,4" Text="准备就绪"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="生成今日汇报" Style="{StaticResource ActionButton}" Click="GenerateReport_Click"/>
                    <Button Content="桌面模式" Style="{StaticResource ActionButton}" Background="#355A79" Click="DesktopMode_Click"/>
                    <Button Content="悬浮模式" Style="{StaticResource ActionButton}" Background="#355A79" Click="FloatMode_Click"/>
                    <Button x:Name="StartupButton" Content="开机自启" Style="{StaticResource ActionButton}" Background="#355A79" Click="Startup_Click"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
